---
interface Props {
  id: string;
  title: string;
  sub?: string;
  tone?: 'p' | 'a' | 's' | 'i' | 'n';
}
const { id, title, sub, tone = 'p' } = Astro.props;
---
<section id={id} class="card" aria-labelledby={`${id}-h`}>
  <div class="card-h">
    <span class={`card-ic ${tone}`} aria-hidden="true"><slot name="icon" /></span>
    <h2 id={`${id}-h`}>{title}</h2>
    {sub && <span class="sub">{sub}</span>}
  </div>
  <div class="card-b"><slot /></div>
</section>
